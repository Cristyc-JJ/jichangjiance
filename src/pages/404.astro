---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
---

<BaseLayout
  title="404 - 页面未找到 | 2026 机场数据检测中心"
  description="您访问的页面不存在或已被移除。"
  noindex={true}
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">404</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-6 items-start">
      <LeftSidebar />

      <section class="flex-1 min-w-0 w-full space-y-6 text-center py-12 bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xs">
        <h1 class="text-6xl sm:text-8xl font-black text-blue-600">404</h1>
        <h2 class="text-2xl font-bold text-slate-800">抱歉，您访问的页面不存在</h2>
        <p class="text-slate-500 max-w-md mx-auto text-sm">可能由于链接输入错误或该页面已被移动，请返回首页继续浏览。</p>
        <div class="pt-4">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-all shadow-sm">
            返回首页
          </a>
        </div>
      </section>

      <RightSidebar />
    </div>

  </main>

  <Footer />
</BaseLayout>
