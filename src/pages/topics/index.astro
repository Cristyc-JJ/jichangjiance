---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import TopicCard from '@/components/TopicCard.astro';
import { topics } from '@/data/topics';
---

<BaseLayout
  title="2026机场推荐专题：客户端、流媒体、AI与安全指南"
  description="按主题整理的系统化内容，包含客户端使用教程、AI 生产力解锁、流媒体 4K 与安全隐私防护指南。"
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">专题聚合大盘</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 (专题网格) -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">2026 机场推荐专题：客户端、流媒体、AI 与安全指南</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">按使用场景分门别类整理的权威指南，助您建立完整知识库</p>
        </div>

        <!-- 3列/2列网格 -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {topics.map(topic => (
            <TopicCard topic={topic} />
          ))}
        </div>

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
