---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { categories, getArticlesByCategory } from '@/data/articles';

export function getStaticPaths() {
  return categories.map(category => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.props;
const articles = getArticlesByCategory(category);
const categorySeoTitles: Record<string, string> = {
  '新手教程': '2026 科学上网新手教程：机场选择、订阅与客户端入门',
  '使用教程': '2026 机场使用教程：订阅导入、节点选择与常见设置',
  '客户端教程': '2026 科学上网客户端教程：Clash、小火箭与 V2Ray 配置',
  '评测对比': '2026 机场评测对比：套餐价格、线路质量与节点测速',
  '问题解答': '2026 机场与科学上网问题解答：连接、订阅与节点排障',
  '进阶技巧': '2026 科学上网进阶技巧：分流规则、测速与性能优化',
  'Apple ID 专题': '2026 美区 Apple ID 专题：共享账号、注册与 App Store 登录',
  '选购与推荐': '2026 机场推荐与选购指南：稳定、高速、性价比机场怎么选',
  '年度指南': '2026 机场推荐年度指南：主流机场排行与选择建议',
  '线路与架构': '2026 机场线路与架构：IPLC、IEPL、BGP 与专线解析',
  '价格与套餐': '2026 机场价格与套餐对比：月付、流量倍率与性价比',
  '客户端生态': '2026 机场客户端生态：Clash、Sing-box、小火箭与 V2Ray',
  '流媒体与 AI': '2026 流媒体与 AI 机场推荐：Netflix、ChatGPT 与 Claude 解锁',
  '跨境商业': '2026 跨境电商与外贸专线：固定 IP、稳定线路与业务安全',
  '评测与排行': '2026 机场排行榜与测速评测：晚高峰、稳定性与可靠性对比',
};
const categorySeoTitle = categorySeoTitles[category] || `${category}：2026 机场推荐、评测与使用指南`;
---

<BaseLayout
  title={`${categorySeoTitle} - 机场检测观察`}
  description={`浏览所有 ${category} 相关的文章、深度测评与客户端配置教程。`}
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-blue-600 transition-colors">博客文章</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">{category}</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">{categorySeoTitle}</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">包含该分类下的权威测评文章、选购建议与技术参数分析</p>

          <!-- 分类筛选 Quick Filter -->
          <div class="mt-4 pt-4 border-t border-blue-200/60 flex flex-wrap gap-2 text-xs font-semibold">
            <a href="/blog/" class="px-3 py-1.5 bg-white/80 hover:bg-blue-600 hover:text-white text-slate-700 rounded-lg transition-colors border border-blue-100">全部文章</a>
            {categories.map(cat => (
              <a
                href={`/category/${cat}/`}
                class={`px-3 py-1.5 rounded-lg transition-colors border ${
                  cat === category
                    ? 'bg-blue-600 text-white font-bold border-blue-600 no-underline'
                    : 'bg-white/80 hover:bg-blue-600 hover:text-white text-slate-700 border-blue-100'
                }`}
                style={cat === category ? 'color: #ffffff !important;' : ''}
              >
                <span style={cat === category ? 'color: #ffffff !important;' : ''}>{cat}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="flex items-center justify-between bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs">
          <span class="text-xs font-mono font-bold text-slate-500 uppercase">CATEGORY FILTER</span>
          <span class="text-xs sm:text-sm font-mono font-extrabold text-blue-600">包含 {articles.length} 篇精选文章</span>
        </div>

        <!-- 2列网格 -->
        {articles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {articles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-2xl border border-slate-200/80 p-12 text-center text-slate-500">
            暂无该分类文章
          </div>
        )}

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
