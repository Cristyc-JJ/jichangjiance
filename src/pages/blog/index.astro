---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { articles, categories } from '@/data/articles';
---

<BaseLayout
  title="2026机场推荐博客：机场评测、客户端教程与科学上网指南"
  description="浏览所有机场相关的教程、客户端配置指引、专线评测和大流量使用指南文章。"
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">博客文章中心</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 (文章网格) -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">2026 机场推荐博客：机场评测、客户端教程与科学上网指南</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">涵盖 Clash / Sing-box / Shadowrocket 配置指导与 2026 年最新机场线路评测</p>

          <!-- 文章分类 Quick Filter -->
          <div class="mt-4 pt-4 border-t border-blue-200/60 flex flex-wrap gap-2 text-xs font-semibold">
            <a href="/blog/" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg font-bold shadow-2xs no-underline" style="color: #ffffff !important;">全部文章 ({articles.length})</a>
            {categories.map(category => (
              <a href={`/category/${category}/`} class="px-3 py-1.5 bg-white/80 hover:bg-blue-600 hover:text-white text-slate-700 rounded-lg transition-colors border border-blue-100">
                {category}
              </a>
            ))}
          </div>
        </div>

        <div class="flex items-center justify-between bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs">
          <span class="text-xs font-mono font-bold text-slate-500 uppercase">ARTICLE COUNT</span>
          <span class="text-xs sm:text-sm font-mono font-extrabold text-blue-600">共收录 {articles.length} 篇精选教程</span>
        </div>

        <!-- 2列网格 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {articles.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
