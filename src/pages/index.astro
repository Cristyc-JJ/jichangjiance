    <!-- 滚动/滑动实时变幻与画风切换脚本 (Scroll Dynamic Transformation Script) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const heroBanner = document.getElementById('hero-illustration-banner');
        const glow1 = document.getElementById('hero-glow-1');
        const glow2 = document.getElementById('hero-glow-2');
        const illustCore = document.getElementById('hero-illust-core-img');
        const illustContainer = document.getElementById('hero-illust-container');
        const leftTextBox = document.getElementById('hero-left-text-box');

        const btnCyber = document.getElementById('theme-btn-cyber');
        const btnNeon = document.getElementById('theme-btn-neon');
        const btnQuantum = document.getElementById('theme-btn-quantum');

        // Mode styles state
        const modes = {
          cyber: {
            bg: 'from-[#0b1220] via-[#0f172a] to-[#131d35]',
            glow1: 'bg-cyan-500/20',
            glow2: 'bg-blue-600/20',
            border: 'border-cyan-500/30'
          },
          neon: {
            bg: 'from-[#1a0b2e] via-[#110f29] to-[#0d1b3a]',
            glow1: 'bg-purple-500/30',
            glow2: 'bg-pink-500/25',
            border: 'border-purple-500/40'
          },
          quantum: {
            bg: 'from-[#061c1d] via-[#08232c] to-[#0f1a30]',
            glow1: 'bg-emerald-400/25',
            glow2: 'bg-cyan-400/25',
            border: 'border-emerald-500/40'
          }
        };

        function setMode(modeKey) {
          const m = modes[modeKey];
          if (!m || !heroBanner) return;
          heroBanner.className = `relative w-full bg-gradient-to-r ${m.bg} border ${m.border} rounded-3xl p-6 sm:p-10 lg:p-12 mb-8 shadow-[0_0_50px_rgba(6,182,212,0.15)] overflow-hidden min-h-[480px] flex flex-col justify-center backdrop-blur-xl transition-all duration-700`;
          if (glow1) glow1.className = `absolute -top-32 -left-32 w-96 h-96 ${m.glow1} rounded-full blur-3xl pointer-events-none transition-all duration-700`;
          if (glow2) glow2.className = `absolute -bottom-32 -right-32 w-96 h-96 ${m.glow2} rounded-full blur-3xl pointer-events-none transition-all duration-700`;
          
          [btnCyber, btnNeon, btnQuantum].forEach(b => {
            if (b) {
              b.className = 'px-2.5 py-0.5 rounded-full text-slate-300 hover:text-cyan-300 transition-all';
            }
          });
          const activeBtn = modeKey === 'cyber' ? btnCyber : modeKey === 'neon' ? btnNeon : btnQuantum;
          if (activeBtn) activeBtn.className = 'px-2.5 py-0.5 rounded-full bg-cyan-500 text-slate-950 font-bold transition-all shadow-xs';
        }

        if (btnCyber) btnCyber.addEventListener('click', () => setMode('cyber'));
        if (btnNeon) btnNeon.addEventListener('click', () => setMode('neon'));
        if (btnQuantum) btnQuantum.addEventListener('click', () => setMode('quantum'));

        // 页面滑动/滚动实时视差与色温演变
        let lastScrollY = window.scrollY;
        window.addEventListener('scroll', () => {
          const scrolled = window.scrollY;
          if (scrolled < 700) {
            const factor = scrolled / 700;
            if (illustCore) {
              illustCore.style.transform = `scale(${1 + factor * 0.15}) rotate(${scrolled * 0.12}deg)`;
            }
            if (illustContainer) {
              illustContainer.style.transform = `translateY(${factor * 20}px) scale(${1 - factor * 0.05})`;
            }
            if (leftTextBox) {
              leftTextBox.style.transform = `translateY(${factor * 12}px)`;
            }
          }
        }, { passive: true });
      });
    </script>
    
