  <!-- 实时图形检测与数据变动 JS -->
  <script>
    (function() {
      // 保存每个 airport 的历史 11 个点 latency 数据
      const historyData = {};
      document.querySelectorAll('[data-node-id]').forEach(card => {
        const id = card.getAttribute('data-node-id');
        const pingEl = card.querySelector('[data-metric="ping"]');
        const basePing = parseInt(pingEl ? pingEl.textContent || '40' : '40', 10) || 40;
        
        // 初始生成 11 个稍微波动的点
        const points = [];
        for (let i = 0; i < 11; i++) {
          points.push(Math.max(15, basePing + Math.floor(Math.random() * 7) - 3));
        }
        historyData[id] = points;
        renderSvgGraph(id);
      });

      // SVG 图形绘制函数
      function renderSvgGraph(id) {
        const svg = document.querySelector(`[data-svg-chart="${id}"]`);
        if (!svg) return;

        const points = historyData[id];
        if (!points || points.length === 0) return;

        const width = 400;
        const height = 40;
        const padding = 6;

        const minVal = Math.min(...points) - 4;
        const maxVal = Math.max(...points) + 4;
        const range = Math.max(1, maxVal - minVal);

        const coords = points.map((val, idx) => {
          const x = (idx / (points.length - 1)) * width;
          const y = height - padding - ((val - minVal) / range) * (height - 2 * padding);
          return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
        });

        // 构造 Line Path (d="M x0,y0 L x1,y1 ...")
        const lineD = coords.map((c, i) => `${i === 0 ? 'M' : 'L'} ${c.x},${c.y}`).join(' ');
        // 构造 Area Path (封闭底部)
        const areaD = `${lineD} L ${width},${height} L 0,${height} Z`;

        const areaPath = svg.querySelector('.chart-area');
        const linePath = svg.querySelector('.chart-line');
        const dot = svg.querySelector('.chart-dot');

        if (areaPath) areaPath.setAttribute('d', areaD);
        if (linePath) linePath.setAttribute('d', lineD);

        const lastCoord = coords[coords.length - 1];
        if (dot && lastCoord) {
          dot.setAttribute('cx', lastCoord.x);
          dot.setAttribute('cy', lastCoord.y);
        }
      }

      // 实时数据与图形变动 Task Engine (每 2.5 秒触发一次)
      function tickRealtimeUpdate() {
        let globalSumPing = 0;
        let globalCount = 0;

        document.querySelectorAll('[data-node-id]').forEach(card => {
          const id = card.getAttribute('data-node-id');
          const pingEl = card.querySelector('[data-metric="ping"]');
          const speedEl = card.querySelector('[data-metric="speed"]');
          const jitterEl = card.querySelector('[data-graphic="jitter"]');
          const currentMsEl = card.querySelector('[data-graphic="current-ms"]');

          if (pingEl && historyData[id]) {
            const currentArray = historyData[id];
            const basePing = currentArray[currentArray.length - 1];
            // 产生新的 latency
            const delta = Math.floor(Math.random() * 5) - 2;
            const newPing = Math.max(15, basePing + delta);
            
            // 更新历史数组
            currentArray.push(newPing);
            currentArray.shift();

            // 更新 DOM 数字
            pingEl.textContent = String(newPing);
            if (currentMsEl) currentMsEl.textContent = `${newPing}ms`;

            // 计算抖动 Jitter
            const jitter = (Math.abs(delta) + (Math.random() * 0.4)).toFixed(1);
            if (jitterEl) jitterEl.textContent = `${jitter}ms`;

            // 更新图形
            renderSvgGraph(id);

            // 闪烁高亮视觉反馈
            if (pingEl.parentElement) {
              pingEl.parentElement.classList.remove('metric-updated');
              void pingEl.parentElement.offsetWidth;
              pingEl.parentElement.classList.add('metric-updated');
            }

            globalSumPing += newPing;
            globalCount++;
          }

          if (speedEl) {
            const currentSpeed = parseInt(speedEl.textContent || '900', 10);
            const speedDelta = Math.floor(Math.random() * 20) - 10;
            speedEl.textContent = String(Math.max(600, currentSpeed + speedDelta));
          }
        });

        // 更新侧边栏全局统计
        if (globalCount > 0) {
          const avgPing = (globalSumPing / globalCount).toFixed(1);
          const globalPingEl = document.getElementById('sidebar-global-ping');
          if (globalPingEl) globalPingEl.textContent = `${avgPing} ms`;
          const globalJitterEl = document.getElementById('sidebar-global-jitter');
          if (globalJitterEl) globalJitterEl.textContent = `${(0.4 + Math.random() * 0.4).toFixed(1)} ms`;
        }
      }

      // 每 2.5 秒更新一次
      setInterval(tickRealtimeUpdate, 2500);

      // 动态日志随机跳动逻辑
      const logAirports = ['EdgeNova', '速界', '可信云', '快狸', '云图', '极速', '瞬云', '极连云', '光年梯'];
      const logTemplates = [
        "深港 IPLC 专线扩容 10G 光纤出口完成，延迟降低 3ms",
        "广港 IEPL 专线完成主备自动容灾演练，全线稳定",
        "BGP 游戏节点网络波动，智能备用链路已秒级无缝自愈",
        "美西 CN2 GIA 4K/8K 流媒体解锁服务自动校验通过",
        "完成分布式探针全量轮询，SLO 达 99.99%",
        "东京 BGP 专线节点新增 40Gbps 备用带宽上线",
        "沪港 02 专线完成网络优化，丢包率恢复为 0.0%",
        "ChatGPT & Claude 官方 API 专属解锁通道扩容",
        "节点加密协议升级至 TLS 1.3 零握手延迟模式",
        "节点负载均衡集群自动剔除高延迟异常链路"
      ];
      const probeIds = ['PROBE-01', 'PROBE-02', 'PROBE-03', 'PROBE-04', 'PROBE-05', 'PROBE-06', 'PROBE-07', 'PROBE-08'];
      const probeColors = ['text-blue-600', 'text-indigo-600', 'text-emerald-600', 'text-cyan-600', 'text-purple-600'];

      function pushRandomLog() {
        const logContainer = document.getElementById('dynamic-log-list');
        if (!logContainer) return;

        const airportName = logAirports[Math.floor(Math.random() * logAirports.length)];
        const template = logTemplates[Math.floor(Math.random() * logTemplates.length)];
        const probe = probeIds[Math.floor(Math.random() * probeIds.length)];
        const colorClass = probeColors[Math.floor(Math.random() * probeColors.length)];

        const newLogItem = document.createElement('div');
        newLogItem.className = 'p-2.5 bg-emerald-50 border border-emerald-300 rounded-xl transition-all duration-500 opacity-0 -translate-y-2 shadow-2xs';
        newLogItem.innerHTML = `
          <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1 font-mono">
            <span class="${colorClass} font-bold">[${probe}]</span>
            <span class="text-emerald-600 font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span> 刚刚
            </span>
          </div>
          <p class="text-slate-800 font-medium leading-snug">
            <strong class="text-slate-900 font-bold">${airportName}</strong> ${template}
          </p>
        `;

        logContainer.insertBefore(newLogItem, logContainer.firstChild);

        requestAnimationFrame(() => {
          setTimeout(() => {
            newLogItem.classList.remove('opacity-0', '-translate-y-2', 'bg-emerald-50', 'border-emerald-300');
            newLogItem.classList.add('bg-slate-50', 'border-slate-100');
          }, 60);
        });

        const items = logContainer.querySelectorAll('div.p-2\\.5');
        if (items.length > 3) {
          const lastItem = items[items.length - 1];
          lastItem.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            if (lastItem && lastItem.parentNode === logContainer) {
              logContainer.removeChild(lastItem);
            }
          }, 350);
        }
      }

      // 每 3.2 秒自动推送一条全新日志
      setInterval(pushRandomLog, 3200);

      // 手动拉取探针按钮
      const manualBtn = document.getElementById('manual-refresh-btn');
      const btnText = document.getElementById('refresh-btn-text');
      const btnIcon = document.getElementById('refresh-icon');

      manualBtn?.addEventListener('click', async () => {
        if (btnText) btnText.textContent = "正在实时测速与刷新图形...";
        if (btnIcon) btnIcon.classList.add("animate-spin");
        manualBtn.disabled = true;

        for (let i = 0; i < 3; i++) {
          tickRealtimeUpdate();
          pushRandomLog();
          await new Promise(res => setTimeout(res, 300));
        }

        if (btnIcon) btnIcon.classList.remove("animate-spin");
        if (btnText) btnText.textContent = "✓ 测速与图形已完成刷新";
        setTimeout(() => {
          if (btnText) btnText.textContent = "重新拉取探针";
          manualBtn.disabled = false;
        }, 1500);
      });
    })();
  </script>
</BaseLayout>
