---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import BrandCard from '@/components/BrandCard.astro';
import { brands } from '@/data/brands';
---

<BaseLayout
  title="品牌库 - 机场检测观察"
  description="主流机场服务商和客户端品牌的详细介绍与评测。"
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">品牌库</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">主流品牌与服务商大盘</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">主流服务商和客户端品牌的详细介绍、特性分析与使用评测</p>
        </div>

        <!-- 品牌列表 -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {brands.map(brand => (
            <BrandCard brand={brand} />
          ))}
        </div>

        <!-- 底部说明 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs space-y-3">
          <h2 class="text-xl font-black text-slate-900">关于品牌库</h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            品牌库收录了主流的机场服务商和客户端品牌信息，包含详细的特性介绍、使用评测和相关教程。每个品牌页面都包含完整的介绍、特性分析、优缺点对比以及相关的使用教程和配置指南，帮助您全面了解和选择。
          </p>
        </div>

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
