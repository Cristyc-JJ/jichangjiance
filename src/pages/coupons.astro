<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toast = document.getElementById('copy-toast');
    const toastCode = document.getElementById('toast-code');
    const container = document.getElementById('coupons-container');
    const cards = Array.from(document.querySelectorAll('.coupon-card'));
    const filterTabs = document.querySelectorAll('.filter-tab');
    const searchInput = document.getElementById('coupon-search');
    const noResults = document.getElementById('no-coupons-found');

    // 复制优惠码并弹出 Toast
    function copyCode(code) {
      if (!code) return;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code);
      } else {
        const textarea = document.createElement('textarea');
        textarea.value = code;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      if (toast && toastCode) {
        toastCode.textContent = code;
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 2200);
      }
    }

    // 绑定所有复制按钮
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const code = btn.getAttribute('data-code');
        copyCode(code);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="text-emerald-300 font-bold">✓ 已复制</span>`;
        btn.classList.add('bg-emerald-700');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-emerald-700');
        }, 1500);
      });
    });

    // 绑定“复制并直达官网”
    document.querySelectorAll('.direct-buy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-code');
        const url = btn.getAttribute('data-url');
        copyCode(code);
        setTimeout(() => {
          window.open(url, '_blank', 'noopener,noreferrer');
        }, 250);
      });
    });

    // 筛选与搜索逻辑
    let currentCategory = 'all';
    let searchQuery = '';

    function filterCoupons() {
      let visibleCount = 0;
      cards.forEach(card => {
        const isSeven = card.getAttribute('data-seven') === 'true';
        const category = card.getAttribute('data-category') || '';
        const name = card.getAttribute('data-name') || '';
        const code = card.getAttribute('data-code') || '';

        // 分类匹配
        let matchesCategory = false;
        if (currentCategory === 'all') {
          matchesCategory = true;
        } else if (currentCategory === '专线') {
          matchesCategory = !isSeven;
        }

        // 搜索匹配
        const matchesSearch = !searchQuery || name.includes(searchQuery) || code.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // Tab 点击
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-xs');
          t.classList.add('bg-slate-100', 'text-slate-700');
        });
        tab.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-xs');
        tab.classList.remove('bg-slate-100', 'text-slate-700');

        currentCategory = tab.getAttribute('data-cat') || 'all';
        filterCoupons();
      });
    });

    // 搜索实时触发
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterCoupons();
      });
    }
  });
</script>
