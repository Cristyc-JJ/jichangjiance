---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { articles, getArticlesByTag } from '@/data/articles';

// 收集所有唯一标签
const allTags = [...new Set(articles.flatMap(article => article.tags))];

export function getStaticPaths() {
  const allTags = [...new Set(articles.flatMap(article => article.tags))];

  return allTags.map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const tagArticles = getArticlesByTag(tag);
const appleIdTag = /apple\s*id|美区id|美区apple/i.test(tag);
const tagSeoTitle = appleIdTag
  ? `${tag}：2026 Apple ID 使用教程与常见问题`
  : `${tag}：2026 机场推荐、评测与使用指南`;
---

<BaseLayout
  title={`${tagSeoTitle} - 机场检测观察`}
  description={`浏览所有包含"${tag}"标签的文章。`}
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-blue-600 transition-colors">博客</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">#{tag}</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-3xl sm:text-4xl text-blue-600 font-black">#</span>
            <h1 class="text-2xl sm:text-4xl font-black text-slate-900">{tagSeoTitle}</h1>
          </div>
          <p class="text-sm sm:text-base text-slate-600 font-medium">共 {tagArticles.length} 篇相关精选教程与评测指南</p>
        </div>

        <!-- 文章列表 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tagArticles.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>

        <!-- 其他热门标签 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs space-y-4">
          <h2 class="text-lg font-black text-slate-900">其他相关标签</h2>
          <div class="flex flex-wrap gap-2">
            {allTags.filter(t => t !== tag).slice(0, 15).map(t => (
              <a
                href={`/tag/${t}/`}
                class="px-3.5 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-colors border border-slate-200/60"
              >
                #{t}
              </a>
            ))}
          </div>
        </div>

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
