  { name: '秒秒云 Miaomiaoyun', logo: '../miaomiaoyun_logo.png', type: '极速 BGP 多线', nodes: '40+', rate: '1.0x 真实扣费', score: '9.0', price: '¥9/月起 (128G)', link: '/reviews/miaomiaoyun-2026/' },
  { name: '云图机场 Yuntu', logo: '../yuntu_logo.png', type: '金融级物理专线', nodes: '50+', rate: '1.0x 真实扣费', score: '8.9', price: '¥22/月起', link: '/reviews/yuntu-2026/' },
