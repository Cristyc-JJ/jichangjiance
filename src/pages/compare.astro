  { name: '闪电鼠', logo: '../shandianshu_logo.png', type: '快速连接优化', nodes: '多地区', rate: '以官网为准', score: '8.7', price: '套餐以官网为准', link: '/brands/shandianshu/' },
  { name: '榴莲云', logo: '../liulianyun_logo.png', type: '大流量中转', nodes: '多地区', rate: '以官网为准', score: '8.6', price: '套餐以官网为准', link: '/brands/liulianyun/' },
  { name: '神行加速', logo: '../shenxing_logo.png', type: '低延迟线路', nodes: '多地区', rate: '以官网为准', score: '8.5', price: '套餐以官网为准', link: '/brands/shenxing/' },
