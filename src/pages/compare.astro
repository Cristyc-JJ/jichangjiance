  { name: '可信云 Kosing', logo: '../kexinyun_logo.png', type: 'IEPL 物理专线', nodes: '40+', rate: '1.0x 真实扣费', score: '9.3', price: '¥15/月 (年付¥96起)', link: '/reviews/kexinyun-2026/' },
  { name: '云界线', logo: '../yunjiexian_logo.png', type: '跨境优化中转', nodes: '多地区', rate: '以官网为准', score: '9.0', price: '套餐以官网为准', link: '/brands/yunjiexian/' },
  { name: '大佬云', logo: '../dalaoyun_logo.png', type: '大带宽多线', nodes: '多地区', rate: '以官网为准', score: '8.9', price: '套餐以官网为准', link: '/brands/dalaoyun/' },
