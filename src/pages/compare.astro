  { name: '极速机场 Jisuyun', logo: '../jisuyun_logo.png', type: '三网 CN2 GIA/9929', nodes: '30+', rate: '1.0x 真实扣费', score: '8.7', price: '¥18/月起', link: '/reviews/jisuyun-2026/' },
  { name: '熊猫cloud Xiongmao', logo: '../xiongmaocloud_logo.png', type: '大带宽巨量吞吐', nodes: '55+', rate: '1.0x 真实扣费', score: '8.6', price: '¥6/月起 (300G)', link: '/reviews/xiongmaocloud-2026/' },
