      if (runPkBtn) {
        runPkBtn.addEventListener('click', () => {
          if (pkLoadingIcon) pkLoadingIcon.classList.remove('hidden');
          runPkBtn.disabled = true;

          setTimeout(() => {
            if (pkLoadingIcon) pkLoadingIcon.classList.add('hidden');
            runPkBtn.disabled = false;
            renderPKResult();
          }, 350);
        });

        // 默认初始化渲染一次
        renderPKResult();
      }

      if (pkSelectA) pkSelectA.addEventListener('change', renderPKResult);
      if (pkSelectB) pkSelectB.addEventListener('change', renderPKResult);

    });
  </script>

  <Footer />
</BaseLayout>
