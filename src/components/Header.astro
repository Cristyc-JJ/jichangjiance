---
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\//, '').replace(/\/$/, '');
const segments = cleanPath ? cleanPath.split('/') : [];
const depth = segments.length;
const prefix = depth === 0 ? './' : '../'.repeat(depth);
const homeHref = depth === 0 ? './index.html' : prefix + 'index.html';

const navItems = [
  { label: '机场检测推荐', path: '', rawHref: '/' },
  { label: '机场评测', path: 'reviews', rawHref: '/reviews/' },
  { label: '客户端教程与下载', path: 'downloads', rawHref: '/downloads/' },
  { label: '科学上网', path: 'knowledge', rawHref: '/knowledge/' },
  { label: 'AI工具推荐', path: 'topics/ai-tools', rawHref: '/topics/ai-tools/' },
  { label: '免费美区ID共享', path: 'apple-id', rawHref: '/apple-id/' },
  { label: '问题库', path: 'faq', rawHref: '/faq/' },
  { label: '关于我们', path: 'about', rawHref: '/about/' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo & Brand Title -->
      <a href={homeHref} class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center shadow-sm shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="text-lg font-extrabold text-slate-800 group-hover:text-blue-600 transition-colors tracking-tight">机场数据检测中心</span>
          <span class="px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200/70 rounded-full flex items-center gap-1.5 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            实时监控
          </span>
        </div>
      </a>

      <!-- Navigation Bar at Top Right (Internal Links, Image 2 Removed) -->
      <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto whitespace-nowrap scrollbar-none text-xs sm:text-sm font-semibold ml-4">
        {navItems.map((item) => {
          const isActive = currentPath === item.rawHref || (item.rawHref !== '/' && currentPath.startsWith(item.rawHref));
          const targetHref = item.path === '' ? homeHref : `${prefix}${item.path}/index.html`;
          return (
            <a
              href={targetHref}
              class={`px-3.5 py-2 rounded-xl transition-all flex items-center gap-1 ${
                isActive
                  ? 'bg-blue-600 text-white font-bold shadow-xs shadow-blue-500/20'
                  : 'text-slate-600 hover:text-blue-600 hover:bg-slate-100/80'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

    </div>
  </div>
</header>

