---
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\//, '').replace(/\/$/, '');
const segments = cleanPath ? cleanPath.split('/') : [];
const depth = segments.length;
const prefix = depth === 0 ? './' : '../'.repeat(depth);

const footerLinks = {
  '内容分类': [
    { label: '新手教程', href: prefix + 'blog/index.html' },
    { label: '机场优惠码', href: prefix + 'coupons/index.html' },
    { label: '客户端教程与下载', href: prefix + 'downloads/index.html' },
    { label: '科学上网知识库', href: prefix + 'knowledge/index.html' },
    { label: '评测对比', href: prefix + 'reviews/index.html' },
  ],
  '重要页面': [
    { label: '机场检测推荐', href: depth === 0 ? './index.html' : prefix + 'index.html' },
    { label: '机场评测', href: prefix + 'reviews/index.html' },
    { label: '机场优惠码', href: prefix + 'coupons/index.html' },
    { label: '客户端教程与下载', href: prefix + 'downloads/index.html' },
    { label: '关于我们', href: prefix + 'about/index.html' },
  ],
  '友情链接': [
    { label: '博客首页', href: prefix + 'blog/index.html' },
    { label: 'AI工具', href: prefix + 'topics/ai-tools/index.html' },
    { label: '科学上网', href: prefix + 'knowledge/index.html' },
    { label: '问题库 (FAQ)', href: prefix + 'faq/index.html' },
  ],
};
---

<footer class="bg-white border-t border-slate-200/80 mt-16">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- 站点简介 -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <span class="text-lg font-bold text-slate-900">机场检测观察</span>
        </div>
        <p class="text-sm text-slate-600 leading-relaxed">
          专注于提供 2026 稳定翻墙机场实时节点数据监测、评测对比与客户端配置指南。
        </p>
      </div>

      <!-- 链接列 -->
      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-4">{title}</h3>
          <ul class="space-y-2">
            {links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-600 hover:text-blue-600 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- 底部版权 -->
    <div class="mt-12 pt-8 border-t border-slate-200">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-600">
        <p>© {currentYear} 机场检测观察. 保留所有权利.</p>
        <p class="text-xs text-slate-500">
          本站内容仅供参考，不构成购买建议 · 请遵守当地法律法规
        </p>
      </div>
    </div>
  </div>
</footer>
