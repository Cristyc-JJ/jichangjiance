---
// LeftSidebar.astro - Standard Left Sidebar for site-wide pages matching Image 2 template
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\//, '').replace(/\/$/, '');
const segments = cleanPath ? cleanPath.split('/') : [];
const depth = segments.length;
const prefix = depth === 0 ? './' : '../'.repeat(depth);
const homeHref = depth === 0 ? './index.html' : prefix + 'index.html';
const addedQuickAirports = [
  { id: 'yunjiexian', name: '云界线', logo: 'yunjiexian_logo.png', ping: '42ms', rank: 8 },
  { id: 'dalaoyun', name: '大佬云', logo: 'dalaoyun_logo.png', ping: '44ms', rank: 9 },
  { id: 'huanqiuti', name: '环球梯', logo: 'huanqiuti_logo.png', ping: '46ms', rank: 10 },
  { id: 'shandianshu', name: '闪电鼠', logo: 'shandianshu_logo.png', ping: '39ms', rank: 11 },
  { id: 'liulianyun', name: '榴莲云', logo: 'liulianyun_logo.png', ping: '45ms', rank: 12 },
  { id: 'shenxing', name: '神行加速', logo: 'shenxing_logo.png', ping: '36ms', rank: 13 },
];
