---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  keywords?: string | string[];
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = '2026 稳定翻墙机场排行榜 & 机场检测观察 - 实时网络质量评估',
  canonical,
  keywords = [
    '免费美区ID共享', '免费美区Apple ID', '机场推荐', '2026机场推荐', '稳定机场推荐',
    '翻墙机场推荐', 'VPN推荐', '梯子推荐', 'IPLC专线机场', 'Clash机场推荐',
    '小火箭机场推荐', 'Shadowrocket节点推荐', 'ChatGPT专用机场', 'Netflix解锁机场', '机场评测'
  ],
  image = '/hero_tech_illust_core.png',
  noindex = false
} = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
const keywordContent = Array.isArray(keywords) ? keywords.join(',') : keywords;
const socialImageURL = new URL(image, Astro.site);
const cleanPath = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const pageDepth = cleanPath ? cleanPath.split('/').length : 0;
const filePrefix = pageDepth === 0 ? './' : '../'.repeat(pageDepth);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="机场检测观察" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <!-- Tailwind CSS CDN Fallback & Config (Preserved in static HTML) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: {
                50: '#eff6ff',
                100: '#dbeafe',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a',
              },
              brand: {
                50: '#eff6ff',
                100: '#dbeafe',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a',
              }
            }
          }
        }
      }
    </script>
    <style is:inline>
      svg { max-width: 100%; }
      img { max-width: 100%; }
    </style>
  </head>
  <body class="bg-white text-slate-800 antialiased min-h-screen" data-file-prefix={filePrefix}>
    <slot />
    <script is:inline>
      if (window.location.protocol === 'file:') {
        const prefix = document.body.dataset.filePrefix || './';
        document.querySelectorAll('a[href^="/"]').forEach((node) => {
          const href = node.getAttribute('href');
          if (href) {
            const [path, hash = ''] = href.split('#');
            const localPath = path.endsWith('/') ? path + 'index.html' : path;
            node.setAttribute('href', prefix + localPath.slice(1) + (hash ? `#${hash}` : ''));
          }
        });
        document.querySelectorAll('a[href]:not([href^="/"]):not([href^="http"]):not([href^="#"]):not([href^="mailto:"]):not([href^="javascript:"])').forEach((node) => {
          const href = node.getAttribute('href');
          if (href) {
            const [path, hash = ''] = href.split('#');
            if (path.endsWith('/')) node.setAttribute('href', path + 'index.html' + (hash ? `#${hash}` : ''));
          }
        });
        document.querySelectorAll('img[src^="/"]').forEach((node) => {
          const src = node.getAttribute('src');
          if (src) node.setAttribute('src', prefix + src.slice(1));
        });
      }
    </script>
  </body>
</html>
